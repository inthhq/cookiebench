{
  "name": "cookiebench",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmark": "node packages/cli/src/index.ts run",
    "build": "turbo run build",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test",
    "dev": "turbo run dev",
    "format": "ultracite fix .",
    "lint": "ultracite check .",
    "lint:fix": "ultracite fix .",
    "typecheck": "turbo run typecheck",
    "test:unit": "vitest run",
    "test": "pnpm --filter @cookiebench/runner test",
    "test:watch": "vitest",
    "db": "node packages/cli/src/index.ts db",
    "cookiebench": "node packages/cli/src/index.ts",
    "fixtures:provenance": "node packages/fixture-support/src/refresh-provenance.ts",
    "source:prepare": "node packages/source-build/src/index.ts --mode all",
    "source:artifacts": "node packages/source-build/src/index.ts --mode artifacts",
    "source:consumer": "node packages/source-build/src/index.ts --mode consumer",
    "source:verify": "node packages/source-build/src/index.ts --mode verify"
  },
  "devDependencies": {
    "@cookiebench/cli": "workspace:*",
    "@oxlint/plugins": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.25.0"
}
