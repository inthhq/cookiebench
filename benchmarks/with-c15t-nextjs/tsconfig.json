{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "react", "react-dom"],
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "next.config.ts",
    "c15t.config.ts",
